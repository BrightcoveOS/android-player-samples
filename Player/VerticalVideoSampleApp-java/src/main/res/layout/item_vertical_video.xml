<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- A full-screen player per page. Every page owns its own SDK player; only the
         page the user is looking at is allowed to start playback. -->
    <com.brightcove.player.view.BrightcoveExoPlayerVideoView
        android:id="@+id/brightcove_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Full-bleed poster shown until playback is likely to keep up. -->
    <ImageView
        android:id="@+id/poster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@color/black" />

    <!-- Tap-to-toggle play/pause indicator, centered over the video. -->
    <ImageView
        android:id="@+id/play_icon"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="center"
        android:alpha="0.0"
        android:contentDescription="@string/video_play"
        android:src="@drawable/ic_play_arrow_white_24dp" />

    <!-- Bottom scrim with the video description. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/vertical_scrim"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/video_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Video description" />

    </LinearLayout>

</FrameLayout>
